import MorleyCategoricityTheorem.ModelTheory.SkolemExpansion

/-!
# Skolem hulls

Let `M` be a model of the Skolem expansion `skolemTheory T` of an `L`-theory `T`, in the expanded
language `L^* = skolemExpansion L`.  The *Skolem hull* `skolemHull L X` of a set `X ⊆ M` is the
`L^*`-substructure generated by `X`.

The Skolem axioms make every `L^*`-substructure of `M` elementary over `L` on reducts
(`Substructure.isElementary_reduct`), so the `L`-reduct of `H(X)` is an elementary `L`-substructure
of `M`: a witness for an existential `L`-formula with parameters in the hull is the value of the
Skolem function of that formula, which lies in the hull by construction.  Consequently a Skolem
hull of a model of `T` is itself a model of `T`, and it is the smallest `L^*`-substructure of `M`
containing `X`.

## Main definitions

- `FirstOrder.Language.skolemHull`: the `(skolemExpansion L)`-substructure generated by a set.
- `FirstOrder.Language.skolemHullElementarySubstructure`: the same hull bundled as an
  `L`-elementary substructure of the ambient structure.

## Main results

- `FirstOrder.Language.skolemHull_reduct_isElementary`: the `L`-reduct of the Skolem hull is
  elementary in `M`.
- `FirstOrder.Language.skolemHull_theory_model`: a Skolem hull of a model of `T` is a model of `T`.
-/

universe u v w

namespace FirstOrder

namespace Language

variable (L : Language.{u, v}) {M : Type w} [(skolemExpansion L).Structure M]

/-! ### The hull of a set -/

/-- The Skolem hull of a set `X` in a structure expanded along the Skolem expansion of `L`: the
`L^*`-substructure generated by `X`. -/
def skolemHull (X : Set M) : (skolemExpansion L).Substructure M :=
  Substructure.closure (skolemExpansion L) X

@[simp]
theorem coe_skolemHull (X : Set M) :
    (skolemHull L X : Set M) = Substructure.closure (skolemExpansion L) X :=
  rfl

@[simp]
theorem subset_skolemHull (X : Set M) : X ⊆ (skolemHull L X : Set M) :=
  Substructure.subset_closure

/-- The hull is the smallest `L^*`-substructure containing `X`. -/
@[simp]
theorem skolemHull_le {X : Set M} {S : (skolemExpansion L).Substructure M} :
    skolemHull L X ≤ S ↔ X ⊆ S :=
  Substructure.closure_le

@[gcongr]
theorem skolemHull_mono {X Y : Set M} (h : X ⊆ Y) : skolemHull L X ≤ skolemHull L Y :=
  Substructure.closure_mono h

/-- The elements of the hull are the values of `L^*`-terms with parameters in `X`. -/
theorem mem_skolemHull_iff_exists_term {X : Set M} {x : M} :
    x ∈ skolemHull L X ↔ ∃ t : (skolemExpansion L).Term X, t.realize (Subtype.val) = x :=
  Substructure.mem_closure_iff_exists_term

/-- Induction on the hull: it suffices to check the generators and to check that the property is
preserved by the function symbols of the Skolem expansion. -/
@[elab_as_elim]
theorem skolemHull_induction {X : Set M} {p : M → Prop} {x : M} (h : x ∈ skolemHull L X)
    (HX : ∀ x ∈ X, p x)
    (Hfun : ∀ {n : ℕ} (f : (skolemExpansion L).Functions n), ClosedUnder f (Set.ofPred p)) :
    p x :=
  Substructure.closure_induction h HX Hfun

variable [L.Structure M] [(skolemExpansionLHom L).IsExpansionOn M]

/-! ### The reduct of the hull is elementary -/

/-- The Skolem hull is an elementary `L`-substructure on reducts: the Skolem axioms provide
Tarski–Vaught witnesses inside the hull. -/
theorem skolemHull_reduct_isElementary (T : L.Theory) [M ⊨ skolemTheory T] (X : Set M) :
    ((skolemExpansionLHom L).substructureReduct (skolemHull L X)).IsElementary :=
  Substructure.isElementary_reduct (T := T) (skolemHull L X)

/-- The Skolem hull, bundled as an `L`-elementary substructure of the ambient structure. -/
def skolemHullElementarySubstructure (T : L.Theory) [M ⊨ skolemTheory T] (X : Set M) :
    L.ElementarySubstructure M :=
  ⟨(skolemExpansionLHom L).substructureReduct (skolemHull L X),
    skolemHull_reduct_isElementary L T X⟩

@[simp]
theorem coe_skolemHullElementarySubstructure (T : L.Theory) [M ⊨ skolemTheory T] (X : Set M) :
    (skolemHullElementarySubstructure L T X : Set M) = (skolemHull L X : Set M) :=
  LHom.coe_substructureReduct (skolemExpansionLHom L) (S := skolemHull L X)

@[simp]
theorem subset_skolemHullElementarySubstructure (T : L.Theory) [M ⊨ skolemTheory T]
    (X : Set M) : X ⊆ (skolemHullElementarySubstructure L T X : Set M) := by
  simp

/-- A Skolem hull of a model of `T` is a model of `T`. -/
theorem skolemHull_theory_model (T : L.Theory) [M ⊨ skolemTheory T] (X : Set M) :
    skolemHullElementarySubstructure L T X ⊨ T := by
  have hT : M ⊨ T := Theory.model_of_model_skolemTheory (T := T) inferInstance
  exact ElementarySubstructure.theory_model (T := T) (S := skolemHullElementarySubstructure L T X)

end Language

end FirstOrder
